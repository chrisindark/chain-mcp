{
  "name": "@chainmcp/server",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisindark/chain-mcp.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@chainmcp/core": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "description": "Model Context Protocol (MCP) server transport adapter supporting stdio and Streamable HTTP with inbound auth.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chainmcp",
    "server",
    "stdio",
    "http",
    "streamable-http"
  ],
  "homepage": "https://github.com/chrisindark/chain-mcp/tree/master/packages/server#readme",
  "bugs": {
    "url": "https://github.com/chrisindark/chain-mcp/issues"
  },
  "engines": {
    "node": ">=22.13"
  }
}
