{
  "name": "@chainmcp/cli",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisindark/chain-mcp.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "chainmcp": "./dist/bin.js",
    "@chainmcp/cli": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin.js || true",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@chainmcp/admin": "workspace:*",
    "@chainmcp/analytics": "workspace:*",
    "@chainmcp/auth": "workspace:*",
    "@chainmcp/compiler": "workspace:*",
    "@chainmcp/config": "workspace:*",
    "@chainmcp/core": "workspace:*",
    "@chainmcp/executor": "workspace:*",
    "@chainmcp/gateway": "workspace:*",
    "@chainmcp/json-navigation": "workspace:*",
    "@chainmcp/rate-limit": "workspace:*",
    "@chainmcp/server": "workspace:*",
    "@chainmcp/storage": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "description": "Developer CLI and server generator for compiling, validating, testing, and serving ChainMcp projects.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chainmcp",
    "cli",
    "generator",
    "scaffolding"
  ],
  "homepage": "https://github.com/chrisindark/chain-mcp/tree/master/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/chrisindark/chain-mcp/issues"
  },
  "engines": {
    "node": ">=22.13"
  }
}
