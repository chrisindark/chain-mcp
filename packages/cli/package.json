{
  "name": "@chainmcp/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisindark/chain-mcp.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "chainmcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin.js || true",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@chainmcp/analytics": "workspace:*",
    "@chainmcp/auth": "workspace:*",
    "@chainmcp/compiler": "workspace:*",
    "@chainmcp/config": "workspace:*",
    "@chainmcp/core": "workspace:*",
    "@chainmcp/executor": "workspace:*",
    "@chainmcp/json-navigation": "workspace:*",
    "@chainmcp/rate-limit": "workspace:*",
    "@chainmcp/server": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  }
}
