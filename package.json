{
  "name": "chainmcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "vitest run --coverage",
    "coverage:show": "node scripts/print-coverage.mjs",
    "coverage:check": "pnpm test:coverage && node scripts/check-coverage.mjs --summary",
    "lint": "eslint .",
    "test:rules": "node --test eslint-rules/no-blocking-io.test.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "docs:check": "node scripts/check-doc-capabilities.mjs",
    "conformance:inspector": "node scripts/inspector-conformance.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sbom": "node scripts/generate-sbom.mjs",
    "sbom:check": "node scripts/generate-sbom.mjs --check",
    "check": "pnpm format:check && pnpm lint && pnpm test:rules && pnpm test:scripts && pnpm docs:check && pnpm build && pnpm typecheck && pnpm test && pnpm version:check && pnpm sbom:check",
    "version:check": "node scripts/sync-version.mjs --check",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/sync-version.mjs",
    "release:publish": "changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}": "prettier --write",
    "*.{ts,tsx,js,mjs,cjs}": "eslint --fix"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.5",
    "vitest": "^3.2.4"
  },
  "license": "Apache-2.0"
}
